rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // AUTH HELPERS
    //
    // IMPORTANT: Super Admin status is NEVER derived from a field on a
    // client-writable document (e.g. users/{uid}.role). It is derived only
    // from a Firebase Auth custom claim, the bootstrap email on the verified
    // ID token, or membership in /admins/{uid} -- a collection only a Super
    // Admin can write to. This closes the self-escalation path where a user
    // could set role: 'super_admin' on their own /users doc.
    // ==========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.yegnaEkub_super_admin == true ||
        (request.auth.token.email != null && (request.auth.token.email == 'yared.abegaz@gmail.com' || request.auth.token.email == 'YARED.ABEGAZ@GMAIL.COM')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Ekub-scoped admin: the caller is the assigned adminId on this specific
    // Ekub, OR is the Super Admin. Reads the Ekub doc itself -- never trusts
    // anything the client claims about its own role.
    function isEkubAdmin(ekubId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/ekubs/$(ekubId)) &&
        get(/databases/$(database)/documents/ekubs/$(ekubId)).data.adminId == request.auth.uid
      );
    }

    function isEkubMember(ekubId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/ekubs/$(ekubId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ekubs/$(ekubId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // ==========================================================================
    // ADMINS COLLECTION -- maps uid -> super-admin grant.
    // Only a Super Admin can grant/revoke this.
    // ==========================================================================
    match /admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ==========================================================================
    // USERS COLLECTION
    // ==========================================================================
    match /users/{userId} {
      // Basic profile lookup
      allow read: if isAuthenticated();

      allow create: if (isOwner(userId) && request.resource.data.role == 'member') || isSuperAdmin();

      // A user may update only their own non-privileged fields.
      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phoneNumber', 'photoURL', 'preferredLanguage',
                    'preferredPaymentMethod', 'updatedAt']) &&
        request.resource.data.role == resource.data.role
      ) || isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // ==========================================================================
    // EKUBS COLLECTION
    // ==========================================================================
    match /ekubs/{ekubId} {
      // Public browsing of Ekubs (for discover, landing page, and member views)
      allow read: if true;

      // Only Super Admin can create a new Ekub directly or via Cloud Function
      allow create: if isSuperAdmin();

      // The assigned Ekub Admin can update operational fields only.
      // Only Super Admin can change adminId (reassignment), isPrivate, or
      // core financial parameters.
      allow update: if isSuperAdmin() || (
        isEkubAdmin(ekubId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'nextContributionDate', 'nextDrawDate', 'rules',
                    'description', 'currentCycle', 'lastDrawDate', 'updatedAt'])
      );

      allow delete: if isSuperAdmin();

      // --- Members Subcollection ---
      match /members/{memberId} {
        // Members roster visible for circle transparency & checking spot status
        allow read: if true;

        allow create: if isEkubAdmin(ekubId) || (
          isOwner(memberId) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.role == 'member' &&
          request.resource.data.hasReceivedPayout == false &&
          request.resource.data.eligibleForDraw == false
        );

        allow update: if isEkubAdmin(ekubId) || (
          isOwner(memberId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'phoneNumber'])
        );

        allow delete: if isSuperAdmin() || isEkubAdmin(ekubId);
      }

      // --- Cycles Subcollection ---
      match /cycles/{cycleId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isEkubAdmin(ekubId);
      }

      // --- Contributions Subcollection ---
      match /contributions/{contributionId} {
        allow get: if isSuperAdmin() || isEkubAdmin(ekubId) ||
          (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow list: if isSuperAdmin() || isEkubAdmin(ekubId) ||
          (isAuthenticated() && resource.data.userId == request.auth.uid);

        // A member can submit a contribution only for themselves, starting as 'pending'
        allow create: if isEkubMember(ekubId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';

        // Verifying/rejecting a contribution is admin-only
        allow update: if isEkubAdmin(ekubId);
        allow delete: if isSuperAdmin();
      }

      // --- Draws Subcollection ---
      match /draws/{drawId} {
        allow read: if true;
        allow create, update: if isSuperAdmin() || isEkubAdmin(ekubId);
        allow delete: if isSuperAdmin();
      }

      // --- Payouts Subcollection ---
      match /payouts/{payoutId} {
        allow read: if true;

        // Payouts are created by Cloud Function / admin execution
        allow create: if isSuperAdmin() || isEkubAdmin(ekubId);

        // Admin can update anything. The winner may submit account details
        allow update: if isEkubAdmin(ekubId) || (
          isAuthenticated() && resource.data.winnerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['submittedDocuments', 'payoutAccountDetails', 'updatedAt', 'status', 'idFileName', 'idDocumentUrl', 'accountDetails']) &&
          (
            request.resource.data.status == resource.data.status ||
            (resource.data.status == 'documents_required' && request.resource.data.status == 'under_review')
          )
        );

        allow delete: if isSuperAdmin();
      }
    }

    // ==========================================================================
    // NOTIFICATIONS COLLECTION
    // ==========================================================================
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isSuperAdmin());

      allow list: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'all')
      );

      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================================================
    // AUDIT LOGS -- append-only
    // ==========================================================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.ekubId != null && isEkubAdmin(resource.data.ekubId));
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ==========================================================================
    // SUPPORT TICKETS
    // ==========================================================================
    match /supportTickets/{ticketId} {
      allow get: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.ekubId != null && isEkubAdmin(resource.data.ekubId));

      allow list: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      allow update: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.ekubId != null && isEkubAdmin(resource.data.ekubId));

      allow delete: if isSuperAdmin();
    }

    // ==========================================================================
    // SYSTEM SETTINGS
    // ==========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
